# Copiar como .env y rellenar con valores reales. Nunca commitear .env.

PORT=3000

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onpilot

# Secretos para firmar los JWT (usar cadenas largas y aleatorias en producción)
JWT_ACCESS_SECRET=cambia-esto-en-produccion-access
JWT_REFRESH_SECRET=cambia-esto-en-produccion-refresh

# true en producción (HTTPS), false en desarrollo local (http)
COOKIE_SECURE=false
