# Copiar como .env y rellenar con valores reales. Nunca commitear .env.

PORT=3000

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onpilot

# Secretos para firmar los JWT (usar cadenas largas y aleatorias en producción)
JWT_ACCESS_SECRET=cambia-esto-en-produccion-access
JWT_REFRESH_SECRET=cambia-esto-en-produccion-refresh

# true en producción (HTTPS), false en desarrollo local (http)
COOKIE_SECURE=false

# API key de Resend, para el email de aviso cuando se registra un negocio
# con sector "Otro" (pendiente de revisión manual).
RESEND_API_KEY=

# A quién avisar cuando hay una cuenta pendiente de revisión.
ADMIN_EMAIL=favi.sanchez.cano@gmail.com

# API key de Anthropic (Claude), para el bot de WhatsApp de H2.
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta for Developers) — ver CLAUDE.md para la guía
# paso a paso de cómo conseguir estos tres valores. WHATSAPP_VERIFY_TOKEN lo
# inventas tú (cadena aleatoria) al configurar el webhook en Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
